# Non-production defaults. compose.yaml already falls back to these values,
# so copying this file to .env is only needed to change something.

# Host ports (bound to 127.0.0.1 only)
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# Grafana admin login (anonymous viewing is enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jira Assets lookup test (scripts/test-assets-lookup.py)
# JIRA_SITE=https://your-site.atlassian.net
# JIRA_EMAIL=svc-observability@example.com
# JIRA_API_TOKEN=
# ASSETS_APPLICATION_SCHEMA=Applications
# ASSETS_INTEGRATION_SCHEMA=Integrations
